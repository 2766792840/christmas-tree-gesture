{
  "name": "aurora-tree-studio",
  "private": true,
  "version": "2.2.0",
  "type": "module",
  "description": "Aurora Tree Studio V2 - gesture particle christmas tree with a full scene editor",
  "scripts": {
    "dev": "vite --port 8782",
    "build": "vite build",
    "preview": "vite preview --port 8783",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "e2e:install": "playwright install --with-deps chromium",
    "bench": "node scripts/benchmark.mjs",
    "bench:merge": "node scripts/merge-benchmarks.mjs",
    "ci": "npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "0.10.14",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@webgpu/types": "^0.1.74",
    "pngjs": "^7.0.0",
    "typescript": "^5.9.2",
    "vite": "^8.4.0",
    "vitest": "^3.2.7"
  }
}
